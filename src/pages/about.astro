---
import { getCollection } from "astro:content";
import { Picture } from "astro:assets";
import teamAvatar1 from "@/assets/about/tally-img-1.png";
import teamAvatar2 from "@/assets/about/tally-img-2.png";
import teamAvatar3 from "@/assets/about/tally-img-3.png";
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";

const teamAvatars: Record<string, typeof teamAvatar1> = {
  "janette-lynch": teamAvatar1,
  "marcell-ziemann": teamAvatar2,
  "robert-palmer": teamAvatar3,
};

// Filter team entries with 'draft: false' & date before current date
const publishedTeamMembers = await getCollection("team", ({ data }) => {
  return !data.draft && data.publishDate < new Date();
});
---

<Layout title="About">
  <Container>
    <Sectionhead>
      <Fragment slot="title">About</Fragment>
      <Fragment slot="desc">We are a passionate team committed to helping businesses work smarter.</Fragment>
    </Sectionhead>

    <div class="mx-auto mt-14 max-w-4xl rounded-3xl border border-slate-200 bg-white p-7 shadow-sm sm:p-10">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
        Supporting Businesses with Reliable Technology Solutions
      </h2>
      <p class="mt-4 text-lg leading-8 text-slate-600">
      At Hi-Tech Soft Solutions, we help businesses manage their accounting and daily operations with reliable TallyPrime solutions. From software installation and company setup to GST billing, inventory management and technical support, we provide practical solutions based on your business requirements.

Our goal is to make accounting easier, improve everyday business processes and provide dependable support that helps businesses stay organised and grow with confidence.
      </p>
    </div>
    <div>
      <h2 class="mt-16 text-center text-3xl font-bold tracking-tight text-slate-900">
        Awards And Achievements
      </h2>
    </div>
    <div class="mx-auto mt-8 grid max-w-5xl gap-6 sm:grid-cols-2 md:grid-cols-3">
      {
        publishedTeamMembers.map((teamMemberEntry) => (
          <div class="group rounded-2xl border border-slate-200 bg-white p-4 shadow-sm transition hover:-translate-y-1 hover:shadow-lg">
            <div class="aspect-square overflow-hidden rounded-xl bg-slate-100">
              <Picture
                src={teamAvatars[teamMemberEntry.id]}
                alt={teamMemberEntry.data.avatar.alt}
                sizes="(max-width: 800px) 100vw, 400px"
                width={400}
                height={400}
                class="aspect-square w-full object-cover object-center transition duration-500 group-hover:scale-105"
              />
            </div>

            <div class="mt-4 text-center">
              <h2 class="text-lg font-semibold text-slate-900">{teamMemberEntry.data.name}</h2>
              <h3 class="mt-1 text-sm text-slate-500">
                {teamMemberEntry.data.title}
              </h3>
            </div>
          </div>
        ))
      }
    </div>
  </Container>
</Layout>
