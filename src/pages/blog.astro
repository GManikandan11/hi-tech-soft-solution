---
import { getCollection } from "astro:content";
import { Picture } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";

// Filter out drafts and posts scheduled for a future date.
const publishedBlogEntries = await getCollection("blog", ({ data }) => {
  return !data.draft && (!data.publishDate || data.publishDate < new Date());
});

// Sort content entries by publication date
publishedBlogEntries.sort(function (a, b) {
  if (!a.data.publishDate) return b.data.publishDate ? 1 : 0;
  if (!b.data.publishDate) return -1;
  return b.data.publishDate.valueOf() - a.data.publishDate.valueOf();
});
---

<Layout title="Blog">
  <Container>
    <Sectionhead>
      <Fragment slot="title">Our Solution</Fragment>
      <Fragment slot="desc">
        Insights, tips and ideas on TallyPrime, accounting and smarter business management.
      </Fragment>
    </Sectionhead>
    <main class="mt-12">
      <ul class="mx-auto grid max-w-6xl gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {
          publishedBlogEntries.map((blogPostEntry, index) => (
            <li class="h-full">
              <a
                href={`/blog/${blogPostEntry.id}`}
                class="group flex h-full flex-col overflow-hidden rounded-xl border border-gray-200 bg-white transition hover:-translate-y-1 hover:shadow-lg focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-blue"
              >
                <Picture
                  src={blogPostEntry.data.image.src}
                  alt={blogPostEntry.data.image.alt}
                  sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 576px"
                  width={800}
                  height={600}
                  loading={index <= 2 ? "eager" : "lazy"}
                  decoding={index <= 2 ? "sync" : "async"}
                  class="aspect-[4/3] w-full object-cover object-center"
                />
                <div class="flex flex-1 flex-col p-6">
                  <span class="text-brand-blue uppercase tracking-wider text-sm font-medium">
                    {blogPostEntry.data.category}
                  </span>

                  <h2 class="mt-1 text-2xl font-semibold leading-snug tracking-tight group-hover:text-brand-blue">
                    {blogPostEntry.data.title}
                  </h2>

                  {
                    (blogPostEntry.data.author || blogPostEntry.data.publishDate) && (
                      <div class="mt-auto flex flex-wrap gap-2 pt-4">
                        {blogPostEntry.data.author && (
                          <span class="text-gray-400">
                            {blogPostEntry.data.author}
                          </span>
                        )}
                        {blogPostEntry.data.author && blogPostEntry.data.publishDate && (
                          <span class="text-gray-400">•</span>
                        )}
                        {blogPostEntry.data.publishDate && (
                          <time
                            class="text-gray-400"
                            datetime={blogPostEntry.data.publishDate.toISOString()}>
                            {blogPostEntry.data.publishDate.toDateString()}
                          </time>
                        )}
                      </div>
                    )
                  }
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </main>
  </Container>
</Layout>
