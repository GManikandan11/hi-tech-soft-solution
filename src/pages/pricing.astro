---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import PricingCard from "@/components/pricing.astro";

const pricing = [
  {
    name: "Silver",
    price: "Single user edition For single PC",
    popular: true,
    features: [
      "Rs. 22,500",
    ],
    button: {
      text: "Get Started",
      link: "/",
    },
  },
  {
    name: "Gold",
    price: "Unlimited multi-user edition For multiple PCs on LAN environment",
    popular: true,
    features: [
      "Rs. 67,500"    ],
    button: {
      text: "Get Started",
      link: "#",
    },
  },
];
---

<Layout title="Pricing">
  <Container>
    <Sectionhead>
      <Fragment slot="title">Tally Prime</Fragment>
      <Fragment slot="desc">
        TallyPrime Plans That Fit Your Business
      </Fragment>
    </Sectionhead>

    <div class="mx-auto mt-12 grid max-w-3xl gap-8 sm:grid-cols-2">
      {pricing.map((item) => <PricingCard plan={item} />)}
    </div>
  </Container>
</Layout>
