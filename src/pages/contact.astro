---
import Contactform from "@/components/contactform.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import Layout from "@/layouts/Layout.astro";
import { Icon } from "astro-icon/components";
---

<Layout title="Contact">
  <Container>
    <Sectionhead>
      <Fragment slot="title">Contact</Fragment>
      <Fragment slot="desc">We are a here to help.</Fragment>
    </Sectionhead>

    <div class="mx-auto mt-14 grid max-w-5xl gap-8 md:grid-cols-2">
      <div class="rounded-3xl bg-gradient-to-br from-blue-50 to-white p-7 sm:p-9">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">Contact Us</h2>
        <p class="mt-3 text-lg leading-8 text-slate-600">
          Have something to say? We are here to help. Fill up the form or send
          email or call phone.
        </p>
        <div class="mt-7 space-y-4">
          <div class="flex items-start gap-3 rounded-xl border border-white bg-white/80 p-4 text-slate-700 shadow-sm">
            <Icon class="mt-1 size-5 shrink-0 text-brand-blue" name="uil:map-marker" />
            <span>2ND FLOOR,OPP- GOVT.HR.
SEC.SCHOOL,
MARKET STREET,ARIYALUR</span>
          </div>
            <div class="flex items-center gap-3 rounded-xl border border-white bg-white/80 p-4 text-slate-700 shadow-sm">
              <Icon class="size-5 shrink-0 text-brand-blue" name="uil:envelope" /><a
                href="mailto:hello@hi-tech-soft-solution.com"
                class="break-all hover:text-brand-blue">hello@hi-tech-soft-solution.com</a
              >
          </div><div class="flex items-center gap-3 rounded-xl border border-white bg-white/80 p-4 text-slate-700 shadow-sm">
            <Icon class="size-5 shrink-0 text-brand-blue" name="uil:phone" /><a
              href="tel:+91  9751228819">+91 97512 28819</a
            >
          </div>
        </div>
      </div>
      <div class="rounded-3xl border border-slate-200 bg-white p-7 shadow-sm sm:p-9">
        <Contactform />
      </div>
    </div>
  </Container>
</Layout>
