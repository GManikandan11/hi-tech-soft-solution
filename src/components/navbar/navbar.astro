---
import Container from "@/components/container.astro";
import Link from "@/components/ui/link.astro";
import Dropdown from "./dropdown.astro";
import { Astronav, MenuItems, MenuIcon } from "astro-navbar";
import { Picture } from "astro:assets";
import Logo from "@/assets/hi-tech-soft-solution-logo.png";

const menuitems = [
    {
    title: "About Us",
    path: "/about",
  },
  {
    title: "Products",
    path: "#",
    children: [
      { title: "TallyPrime", path: "/" },
      { title: "Tally TSS", path: "#" },
      { title: "Tally Upgrade", path: "#" },
      { title: "Tally Prime Prowered by AWS", path: "/" },
      { title: "Tally Prime WithWhatsapp", path: "#" },
    ],
  },
  {
    title: "Tally Prime",
    path: "/pricing",
  },

  {
    title: "Solutions",
    path: "/blog",
  },
];
---

<div class="sticky top-0 z-50 border-b border-slate-200/80 bg-white/95 shadow-sm backdrop-blur-md">
  <Container>
    <header class="flex flex-col items-center justify-between py-3 lg:flex-row">
    <Astronav>
      <div class="flex w-full lg:w-auto items-center justify-between">
        <a href="/" aria-label="Hi-Tech Soft Solution home">
          <Picture
            src={Logo}
            alt="Hi-Tech Soft Solution"
            widths={[100, 200]}
            sizes="(max-width: 1023px) 112px, 80px"
            class="h-auto w-28 lg:h-20 lg:w-20 lg:object-contain"
            loading="eager"
            format="avif"
          />
        </a>
        <div class="block lg:hidden">
          <MenuIcon class="size-6 text-brand-blue" />
        </div>
      </div>
      <MenuItems class="hidden w-full border-t border-slate-100 pb-4 pt-3 text-left lg:mt-0 lg:flex lg:w-auto lg:border-0 lg:py-0">
        <ul class="flex w-full flex-col items-start lg:w-auto lg:flex-row lg:items-center lg:gap-1">
          {
            menuitems.map((item, index) => (
              <>
                {item.children && (
                  <Dropdown
                    title={item.title}
                    children={item.children}
                    lastItem={index === menuitems.length - 1}
                  />
                )}

                {!item.children && (
                  <li class="w-full lg:w-auto">
                    <a
                      href={item.path}
                      class="flex w-full items-center justify-start rounded-lg px-3 py-2 text-left font-medium text-slate-700 transition hover:bg-blue-50 hover:text-brand-blue lg:w-auto">
                      <span> {item.title}</span>
                      {/* {item.badge && (
                        <span class="ml-1 px-2 py-0.5 text-[10px] animate-pulse font-semibold uppercase text-white bg-brand-green rounded-full">
                          New
                        </span>
                      )} */}
                    </a>
                  </li>
                )}
              </>
            ))
          }
        </ul>
        <div class="lg:hidden flex items-center mt-3 gap-4">
          <!-- <Link href="#" style="muted" block size="md">Log in</Link> -->
          <Link href="contact" size="md" block>Contact Us</Link>
        </div>
      </MenuItems>
    </Astronav>
    <div>
      <div class="hidden lg:flex items-center gap-4">
        <!-- <a href="#">Log in</a> -->
        <Link href="contact" size="md">Contact Us</Link>
      </div>
    </div>
    </header>
  </Container>
</div>
