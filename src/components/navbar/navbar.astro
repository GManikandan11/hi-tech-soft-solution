---
import Container from "@/components/container.astro";
import Link from "@/components/ui/link.astro";
import Dropdown from "./dropdown.astro";
import { Astronav, MenuItems, MenuIcon } from "astro-navbar";
import { Picture } from "astro:assets";
import Logo from "@/assets/hi-tech-soft-solution-logo.png";

const menuitems = [
    {
    title: "About Us",
    path: "/about",
  },
  {
    title: "Products",
    path: "#",
    children: [
      { title: "Action", path: "/" },
      { title: "Another action", path: "#" },
      { title: "Dropdown Submenu", path: "#" },
      { title: "404 Page", path: "/404" },
    ],
  },
  {
    title: "Tally Prime",
    path: "/pricing",
  },

  {
    title: "Solutions",
    path: "/blog",
  },
  {
    title: "Contact",
    path: "/contact",
  },
];
---

<div class="sticky top-0 z-50 bg-white shadow-sm">
  <Container>
    <header class="flex flex-col lg:flex-row justify-between items-center pt-3 pb-0">
    <Astronav>
      <div class="flex w-full lg:w-auto items-center justify-between">
        <a href="/" aria-label="Hi-Tech Soft Solution home">
          <Picture
            src={Logo}
            alt="Hi-Tech Soft Solution"
            widths={[100, 200]}
            sizes="96px"
            class="w-24 h-auto"
            loading="eager"
            format="avif"
          />
        </a>
        <div class="block lg:hidden">
          <MenuIcon class="w-4 h-4 text-brand-blue" />
        </div>
      </div>
      <MenuItems class="hidden w-full lg:w-auto mt-2 lg:flex lg:mt-0">
        <ul class="flex flex-col lg:flex-row lg:gap-3">
          {
            menuitems.map((item, index) => (
              <>
                {item.children && (
                  <Dropdown
                    title={item.title}
                    children={item.children}
                    lastItem={index === menuitems.length - 1}
                  />
                )}

                {!item.children && (
                  <li>
                    <a
                      href={item.path}
                      class="flex lg:px-3 py-2 items-center text-brand-blue hover:text-brand-green">
                      <span> {item.title}</span>
                      {/* {item.badge && (
                        <span class="ml-1 px-2 py-0.5 text-[10px] animate-pulse font-semibold uppercase text-white bg-brand-green rounded-full">
                          New
                        </span>
                      )} */}
                    </a>
                  </li>
                )}
              </>
            ))
          }
        </ul>
        <div class="lg:hidden flex items-center mt-3 gap-4">
          <!-- <Link href="#" style="muted" block size="md">Log in</Link> -->
          <Link href="#" size="md" block>Contact Us</Link>
        </div>
      </MenuItems>
    </Astronav>
    <div>
      <div class="hidden lg:flex items-center gap-4">
        <!-- <a href="#">Log in</a> -->
        <Link href="#" size="md">Contact Us</Link>
      </div>
    </div>
    </header>
  </Container>
</div>
