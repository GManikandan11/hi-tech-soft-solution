---
import { Dropdown as DropdownContainer, DropdownItems } from "astro-navbar";
const { title, lastItem, children } = Astro.props;
---

<li class="relative w-full lg:w-auto">
  <DropdownContainer class="group">
    <button
      class="flex w-full items-center justify-start gap-1 rounded-lg px-3 py-2 text-left font-medium text-slate-700 transition hover:bg-blue-50 hover:text-brand-blue lg:w-auto">
      <span>{title}</span>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="3"
        stroke="currentColor"
        class="w-3 h-3 mt-0.5 group-open:rotate-180">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path>
      </svg>
    </button>
    <DropdownItems>
      <div
        class:list={[
          "lg:absolute w-full lg:w-48 z-10",
          lastItem
            ? "lg:right-0 origin-top-right"
            : "lg:left-0 origin-top-left",
        ]}>
        <div
          class="mt-1 flex flex-col rounded-xl border border-slate-200 bg-white px-3 py-2 shadow-xl">
          {
            children.map((item) => (
              <a
                href={item.path}
                class="rounded-lg py-2 text-slate-700 transition hover:bg-blue-50 hover:text-brand-blue">
                {item.title}
              </a>
            ))
          }
        </div>
      </div>
    </DropdownItems>
  </DropdownContainer>
</li>
