---
import { Tick } from "@/components/ui/icons";
import Link from "@/components/ui/link.astro";

const { plan } = Astro.props;
---

<div class="h-full">
  <div
    class:list={[
      "flex h-full w-full flex-col rounded-3xl border bg-white p-7 shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-xl sm:p-8",
      plan.popular ? "border-brand-blue/40 shadow-brand-blue/10" : "border-slate-200",
    ]}>
    <div class="text-center">
      <h4 class="text-2xl font-bold text-slate-900">{plan.name}</h4>
      <p class="mt-3 min-h-14 leading-7 text-slate-600">
        {
          plan.price && typeof plan.price === "object"
            ? plan.price.monthly
            : plan.price
        }
      </p>
      <!-- {
        plan.price.original && (
          <p class="mt-1 text-xl font-medium text-gray-400 line-through md:text-2xl">
            {plan.price.original}
          </p>
        )
      } -->
    </div><ul class="mt-7 grid gap-y-4 text-left">
      {
        plan.features.map((item, index) => (
          <li class:list={["flex items-start gap-3 text-slate-800", index === 0 && "text-3xl font-bold text-brand-blue"]}>
            {index === 0 ? <span class="text-3xl font-bold text-brand-blue">{item}</span> : <><Tick class="mt-0.5 size-5 shrink-0 text-brand-green" /><span>{item}</span></>}
          </li>
        ))
      }
    </ul><div class="mt-auto flex pt-8">
      <Link
        href={plan.button.link || "#"}
        block
        style={plan.popular ? "primary" : "outline"}>
        {plan.button.text || "Get Started"}
      </Link>
    </div>
  </div>
</div>
