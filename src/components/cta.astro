
---
import Link from "./ui/link.astro";
---

<div
  class="bg-brand-blue p-8 md:px-20 md:py-20 mt-20 mx-auto max-w-5xl rounded-lg flex flex-col items-center text-center">
  <h2 class="text-white text-4xl md:text-6xl tracking-tight">
    Simplify Your Business with TallyPrime.
  </h2>
  <p class="text-slate-400 mt-4 text-lg md:text-xl max-w-3xl">
    Manage your accounting, GST billing and inventory with ease. Get expert
    TallyPrime installation, setup and support from Hi-Tech Soft Solutions.
  </p>
  <div class="flex mt-5">
    <Link href="/contact" style="inverted">Get in Touch</Link>
  </div>
</div>
