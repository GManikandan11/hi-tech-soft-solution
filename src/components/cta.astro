
---
import Link from "./ui/link.astro";
---

<div
  class="relative mx-auto mt-20 flex max-w-5xl flex-col items-center overflow-hidden rounded-3xl bg-gradient-to-br from-brand-blue to-slate-900 px-6 py-12 text-center shadow-xl shadow-brand-blue/15 md:mt-24 md:px-20 md:py-16">
  <div class="absolute -right-20 -top-24 size-72 rounded-full bg-white/10 blur-3xl"></div>
  <h2 class="relative text-3xl font-bold tracking-tight text-white sm:text-4xl md:text-5xl">
    Simplify Your Business with TallyPrime.
  </h2>
  <p class="relative mt-4 max-w-3xl text-lg leading-8 text-blue-100 md:text-xl">
    Manage your accounting, GST billing and inventory with ease. Get expert
    TallyPrime installation, setup and support from Hi-Tech Soft Solutions.
  </p>
  <div class="relative mt-7 flex">
    <Link href="/contact" style="inverted">Get in Touch</Link>
  </div>
</div>
