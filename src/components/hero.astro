---
import { Picture } from "astro:assets";
import heroImage from "@/assets/tally-img.png";
import Link from "@/components/ui/link.astro";
import { Icon } from "astro-icon/components";
---

<main class="relative isolate overflow-hidden bg-gradient-to-br from-blue-50 via-white to-emerald-50">
  <div class="hero-copy mx-auto grid max-w-(--breakpoint-xl) px-5 py-10 sm:py-12 md:py-14 lg:grid-cols-[1.05fr_0.95fr] lg:items-center lg:py-16">
  <div class="relative z-10">
    <span class="inline-flex items-center gap-2 rounded-full border border-brand-blue/15 bg-white/80 px-4 py-2 text-sm font-semibold text-brand-blue shadow-sm">
      <span class="size-2 rounded-full bg-brand-green"></span>
      TallyPrime solutions for growing businesses
    </span>
    <h1 class="mt-6 max-w-2xl text-4xl font-bold leading-tight tracking-tight text-slate-950 sm:text-5xl lg:text-6xl">
      Make business accounting feel <span class="text-brand-blue">simpler.</span>
    </h1>
    <p class="mt-5 max-w-xl text-lg leading-8 text-slate-600">
      A reliable business tool like Tally makes it easier to manage your daily
      accounting, keep track of finances, and stay in control of your business.
      As your business grows, the right tools and support help simplify everyday
      tasks and keep operations running smoothly.
    </p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <Link href="/pricing" class="inline-flex items-center justify-center gap-2">
        Explore TallyPrime
        <Icon class="size-4" name="uil:arrow-right" />
      </Link>
      <Link
        style="outline"
        href="/contact"
        class="inline-flex items-center justify-center gap-2">
        <Icon class="size-4" name="uil:phone" />
        Talk to our team
      </Link>
    </div>
    <div class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm font-medium text-slate-600">
      <span class="inline-flex items-center gap-2"><Icon class="size-4 text-brand-green" name="uil:check-circle" />Setup &amp; training</span>
      <span class="inline-flex items-center gap-2"><Icon class="size-4 text-brand-green" name="uil:check-circle" />GST &amp; inventory</span>
    </div>
  </div>
  <div class="relative mt-8 lg:mt-0">
    <div class="absolute inset-8 rounded-full bg-brand-blue/10 blur-3xl"></div>
    <Picture
      src={heroImage}
      alt="Business team reviewing accounting and inventory information"
      widths={[400, 600, 900]}
      sizes="(max-width: 1024px) 100vw, 560px"
      loading="eager"
      format="avif"
      class="relative mx-auto w-full max-w-xl drop-shadow-sm"
    />
  </div>
  </div>
</main>

<style>
  @keyframes hero-text-enter {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-copy > div > * {
    animation: hero-text-enter 700ms ease-out both;
  }

  .hero-copy > div > :nth-child(2) {
    animation-delay: 120ms;
  }

  .hero-copy > div > :nth-child(3),
  .hero-copy > div > :nth-child(4) {
    animation-delay: 240ms;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-copy > div > * {
      animation: none;
    }
  }
</style>
