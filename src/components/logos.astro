---
const capabilities = [
  "Accounting",
  "GST billing",
  "Inventory management",
  "Data migration",
  "Technical support",
];
---

<section class="mt-20 border-y border-slate-200 py-10 md:mt-24" aria-label="Our TallyPrime capabilities">
  <p class="text-center text-sm font-semibold uppercase tracking-[0.16em] text-slate-500">
    Practical support for every step
  </p>
  <ul class="mt-6 flex flex-wrap items-center justify-center gap-3">
    {
      capabilities.map((capability) => (
        <li class="rounded-full border border-slate-200 bg-white px-5 py-2.5 text-sm font-medium text-slate-700 shadow-sm">
          {capability}
        </li>
      ))
    }
  </ul>
</section>
