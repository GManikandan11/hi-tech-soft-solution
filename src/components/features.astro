---
// @ts-ignore
import { Icon } from "astro-icon/components";

const features = [
  {
    title: "TallyPrime Installation",
    description:
      "Get professional TallyPrime software installation and activation support. We help businesses set up Tally with the right configuration to get started smoothly.",
    icon: "bx:bxs-download",
  },
  {
    title: "Company Setup & Configuration",
    description:
      "We configure company profiles, ledgers, accounting groups, GST settings, vouchers, and other essential features based on your business requirements.",
    icon: "bx:bxs-cog",
  },
  {
    title: "Accounting & Inventory Management",
    description:
      "Manage daily sales, purchases, payments, receipts, stock details, and outstanding balances with an organised and efficient accounting system.",
    icon: "bx:bxs-data",
  },
  {
    title: "GST & Billing Support",
    description:
      "Simplify your billing operations with GST invoice setup, tax configurations, e-invoicing, and e-Way Bill support in TallyPrime.",
    icon: "bx:bxs-receipt",
  },
  {
    title: "Data Migration & Backup",
    description:
      "Move your existing accounting data to TallyPrime, upgrade software versions, and configure regular backups to help protect important business information.",
    icon: "bx:bxs-cloud-upload",
  },
  {
    title: "Training & Technical Support",
    description:
      "Get practical TallyPrime training, troubleshooting, and ongoing technical assistance to help your team manage everyday accounting tasks confidently.",
    icon: "bx:bxs-user-check",
  },
];
---

<div class="mt-16 md:mt-0">
  <h2 class="text-4xl lg:text-5xl font-bold lg:tracking-tight">
    Tally Software Services
  </h2>
  <p class="text-lg mt-4 text-slate-600">
We provide complete TallyPrime software solutions to help businesses
    simplify accounting, manage inventory, handle GST billing, and maintain
    accurate financial records. From software installation and company
    configuration to data migration and technical support, we help you
    get the most out of Tally and keep your business operations running smoothly.

  </p>
</div>

<div class="grid sm:grid-cols-2 md:grid-cols-3 mt-16 gap-16">
  {
    features.map((item) => (
      <div class="flex gap-4 items-start">
        <div class="mt-1 bg-brand-blue rounded-full p-2 w-8 h-8 shrink-0">
          <Icon class="text-white" name={item.icon} />
        </div>
        <div>
          <h3 class="font-semibold text-lg">{item.title}</h3>{" "}
          <p class="text-slate-500 mt-2 leading-relaxed">{item.description}</p>
        </div>
      </div>
    ))
  }
</div>
