---
const { align = "center" } = Astro.props;
---

<div class:list={["mx-auto mt-12 max-w-3xl sm:mt-16", align === "center" && "text-center"]}>
  <h1 class="text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl">
    <slot name="title">Title</slot>
  </h1>
  <p class="mt-4 text-lg leading-8 text-slate-600">
    <slot name="desc">Some description goes here</slot>
  </p>
</div>
